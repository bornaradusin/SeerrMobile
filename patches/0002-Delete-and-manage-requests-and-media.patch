+interface RequestActionsProps {
+  canManage: boolean;
+  isOwn: boolean;
+  canEditOwn: boolean;
+  status: MediaRequestStatus;
+  canRemove: boolean;
+  arr: string;
+  updatingType: 'approve' | 'decline' | null;
+  isRetrying: boolean;
+  onApprove: () => void;
+  onDecline: () => void;
+  onEdit: () => void;
+  onRetry: () => void;
+  onDelete: () => void;
+  onRemoveMedia: () => void;
+}
+
+/** SeerrMobile: approve, decline, edit, retry, delete or cancel a request, as on the web. */
+const RequestActions = ({
+  canManage,
+  isOwn,
+  canEditOwn,
+  status,
+  canRemove,
+  arr,
+  updatingType,
+  isRetrying,
+  onApprove,
+  onDecline,
+  onEdit,
+  onRetry,
+  onDelete,
+  onRemoveMedia,
+}: RequestActionsProps) => {
+  const intl = useIntl();
+  const pending = status === MediaRequestStatus.PENDING;
+  const showRetry = status === MediaRequestStatus.FAILED && canManage;
+  const showDelete = !pending && canManage;
+  const showDecide = pending && canManage;
+  const showEdit = pending && (canManage || (isOwn && canEditOwn));
+  const showCancel = pending && !canManage && isOwn;
+
+  if (!showRetry && !showDelete && !showDecide && !showEdit && !showCancel) {
+    return null;
+  }
+
+  return (
+    <View className="mt-2 flex flex-row flex-wrap gap-2">
+      {showRetry && (
+        <Button buttonType="primary" onClick={onRetry} disabled={isRetrying}>
+          {intl.formatMessage(
+            isRetrying ? globalMessages.retrying : globalMessages.retry
+          )}
+        </Button>
+      )}
+      {showDecide && (
+        <>
+          <Button
+            buttonType="success"
+            onClick={onApprove}
+            disabled={updatingType !== null}
+          >
+            {intl.formatMessage(globalMessages.approve)}
+          </Button>
+          <Button
+            buttonType="danger"
+            onClick={onDecline}
+            disabled={updatingType !== null}
+          >
+            {intl.formatMessage(globalMessages.decline)}
+          </Button>
+        </>
+      )}
+      {showEdit && (
+        <Button
+          buttonType="ghost"
+          onClick={onEdit}
+          disabled={updatingType !== null}
+        >
+          {intl.formatMessage(messagesRequestList.editrequest)}
+        </Button>
+      )}
+      {showDelete && (
+        <ConfirmButton
