+// SeerrMobile: managing a movie or series, as Seerr's web app does (src/components/ManageSlideOver):
+// its requests (delete them), removing it from Radarr or Sonarr with its files, marking it
+// available, and clearing its data.
+import Badge from '@app/components/Common/Badge';
+import Button from '@app/components/Common/Button';
+import CachedImage from '@app/components/Common/CachedImage';
+import ConfirmButton from '@app/components/Common/ConfirmButton';
+import Modal from '@app/components/Common/Modal';
+import ThemedText from '@app/components/Common/ThemedText';
+import useServerUrl from '@app/hooks/useServerUrl';
+import useSettings from '@app/hooks/useSettings';
+import useToasts from '@app/hooks/useToasts';
+import { Permission, useUser } from '@app/hooks/useUser';
+import getSeerrMessages from '@app/utils/getSeerrMessages';
+import globalMessages from '@app/utils/globalMessages';
+import { MediaRequestStatus, MediaStatus } from '@server/constants/media';
+import { MediaServerType } from '@server/constants/server';
+import type { RadarrSettings, SonarrSettings } from '@server/lib/settings';
+import type { MovieDetails } from '@server/models/Movie';
+import type { TvDetails } from '@server/models/Tv';
+import axios from 'axios';
+import { useState } from 'react';
+import { useIntl } from 'react-intl';
+import { View } from 'react-native';
+import useSWR from 'swr';
+
+const messages = getSeerrMessages('components.ManageSlideOver');
+const requestMessages = getSeerrMessages('components.RequestList.RequestItem');
+
+interface ManageSlideOverProps {
+  show: boolean;
+  mediaType: 'movie' | 'tv';
+  data: MovieDetails | TvDetails;
+  onClose: () => void;
+  revalidate: () => void;
+}
+
+const ManageSlideOver = ({
+  show,
+  mediaType,
+  data,
+  onClose,
+  revalidate,
+}: ManageSlideOverProps) => {
+  const serverUrl = useServerUrl();
+  const intl = useIntl();
+  const settings = useSettings();
+  const { hasPermission } = useUser();
+  const { addToast } = useToasts();
+  const [busy, setBusy] = useState(false);
+  const isAdmin = hasPermission(Permission.ADMIN);
+  const media = data.mediaInfo;
+  const arr = mediaType === 'movie' ? 'Radarr' : 'Sonarr';
+  const kind = intl.formatMessage(
+    mediaType === 'movie' ? messages.movie : messages.tvshow
+  );
+  const enabled4k =
+    mediaType === 'movie'
+      ? settings.currentSettings.movie4kEnabled
+      : settings.currentSettings.series4kEnabled;
+
+  const { data: radarrData } = useSWR<RadarrSettings[]>(
+    show && isAdmin && mediaType === 'movie'
+      ? `${serverUrl}/api/v1/settings/radarr`
+      : null
+  );
+  const { data: sonarrData } = useSWR<SonarrSettings[]>(
+    show && isAdmin && mediaType === 'tv'
+      ? `${serverUrl}/api/v1/settings/sonarr`
+      : null
+  );
+
+  // Removing files goes through the default server only, as on the web
+  const isDefaultService = (is4k: boolean) => {
+    const servers = mediaType === 'movie' ? radarrData : sonarrData;
+    const id = is4k ? media?.serviceId4k : media?.serviceId;
+    return (
+      servers?.some(
+        (s) => s.isDefault && (!is4k || s.is4k) && s.id === id
+      ) ?? false
+    );
+  };
+
+  const requests =
+    media?.requests?.filter(
+      (request) => request.status !== MediaRequestStatus.DECLINED
+    ) ?? [];
+
+  const run = async (action: () => Promise<void>, error: string) => {
+    setBusy(true);
+    try {
+      await action();
+    } catch (e) {
+      if (!axios.isAxiosError(e) || e.response?.status !== 404) {
+        addToast(error, { appearance: 'error', autoDismiss: true });
+      }
+    } finally {
+      setBusy(false);
+      revalidate();
+    }
+  };
+
+  const deleteRequest = (requestId: number) =>
+    run(
+      () => axios.delete(`${serverUrl}/api/v1/request/${requestId}`),
+      intl.formatMessage(requestMessages.failedmodify)
+    );
+
+  const deleteMediaFile = (is4k: boolean) =>
+    run(async () => {
+      await axios.delete(
+        `${serverUrl}/api/v1/media/${media?.id}/file?is4k=${is4k}`
+      );
+      onClose();
+    }, intl.formatMessage(messages.removemediaerror));
+
+  const markAvailable = (is4k: boolean) =>
+    run(
+      () =>
+        axios.post(`${serverUrl}/api/v1/media/${media?.id}/available`, {
+          is4k,
+          ...(mediaType === 'tv' && {
+            seasons: (data as TvDetails).seasons.filter(
+              (season) => season.seasonNumber !== 0
+            ),
+          }),
+        }),
+      intl.formatMessage(messages.removemediaerror)
+    );
+
+  const deleteMedia = () =>
+    run(async () => {
+      await axios.delete(`${serverUrl}/api/v1/media/${media?.id}`);
+      onClose();
+    }, intl.formatMessage(messages.clearmediadataerror));
+
+  const mediaServerName =
+    settings.currentSettings.mediaServerType === MediaServerType.EMBY
+      ? 'Emby'
+      : settings.currentSettings.mediaServerType === MediaServerType.PLEX
+        ? 'Plex'
+        : 'Jellyfin';
+
+  const Heading = ({ children }: { children: React.ReactNode }) => (
+    <ThemedText className="mb-2 mt-4 text-xl font-bold text-white">
+      {children}
+    </ThemedText>
+  );
+
+  const removeButton = (is4k: boolean) =>
+    isAdmin &&
+    (is4k ? media?.serviceUrl4k : media?.serviceUrl) &&
+    isDefaultService(is4k) && (
+      <View className="mt-2">
+        <ConfirmButton
+          onClick={() => deleteMediaFile(is4k)}
+          confirmText={intl.formatMessage(globalMessages.areyousure)}
+          className="w-full"
+        >
+          <ThemedText className="text-white">
+            {intl.formatMessage(is4k ? messages.removearr4k : messages.removearr, {
+              arr,
+            })}
+          </ThemedText>
+        </ConfirmButton>
+        <ThemedText className="mt-1 text-xs text-gray-400">
+          {intl.formatMessage(messages.manageModalRemoveMediaWarning, {
+            mediaType: kind,
+            arr,
+          })}
+        </ThemedText>
+      </View>
+    );
+
+  return (
+    <Modal
+      show={show}
+      title={intl.formatMessage(messages.manageModalTitle, { mediaType: kind })}
+      subTitle={'title' in data ? data.title : data.name}
+      onCancel={onClose}
+      cancelText={intl.formatMessage(globalMessages.close)}
+      loading={busy}
+    >
+      <Heading>{intl.formatMessage(messages.manageModalRequests)}</Heading>
+      {requests.length === 0 ? (
+        <ThemedText className="text-gray-400">
+          {intl.formatMessage(messages.manageModalNoRequests)}
+        </ThemedText>
+      ) : (
+        requests.map((request) => (
+          <View
+            key={`manage-request-${request.id}`}
+            className="mb-2 flex flex-row items-center gap-3 rounded-md border border-gray-700 bg-gray-900/60 p-3"
+          >
+            <CachedImage
+              type="avatar"
+              src={request.requestedBy?.avatar}
+              alt=""
+              style={{ width: 28, height: 28, borderRadius: 14 }}
+            />
+            <View className="flex-1">
+              <ThemedText className="font-semibold text-white">
+                {request.requestedBy?.displayName}
+              </ThemedText>
+              <View className="mt-1 flex flex-row flex-wrap gap-1">
+                {request.is4k && <Badge badgeType="warning">4K</Badge>}
+                <Badge
+                  badgeType={
+                    request.status === MediaRequestStatus.PENDING
+                      ? 'warning'
+                      : request.status === MediaRequestStatus.FAILED
+                        ? 'danger'
+                        : 'success'
+                  }
+                >
+                  {intl.formatMessage(
+                    request.status === MediaRequestStatus.PENDING
+                      ? globalMessages.pending
+                      : request.status === MediaRequestStatus.FAILED
+                        ? globalMessages.failed
+                        : globalMessages.approved
+                  )}
+                </Badge>
+              </View>
+            </View>
+            {hasPermission(Permission.MANAGE_REQUESTS) && (
+              <ConfirmButton
+                onClick={() => deleteRequest(request.id)}
+                confirmText={intl.formatMessage(globalMessages.areyousure)}
+              >
+                <ThemedText className="text-white">
+                  {intl.formatMessage(globalMessages.delete)}
+                </ThemedText>
+              </ConfirmButton>
+            )}
+          </View>
+        ))
+      )}
+
+      {isAdmin && media && (
+        <>
+          <Heading>{intl.formatMessage(messages.manageModalMedia)}</Heading>
+          {media.status !== MediaStatus.AVAILABLE &&
+            media.status !== MediaStatus.BLOCKLISTED && (
+              <Button
+                buttonType="success"
+                className="w-full"
+                onClick={() => markAvailable(false)}
+                disabled={busy}
+              >
+                {intl.formatMessage(
+                  mediaType === 'movie'
+                    ? messages.markavailable
+                    : messages.markallseasonsavailable
+                )}
+              </Button>
+            )}
+          {removeButton(false)}
+
+          {enabled4k && (
+            <>
+              <Heading>{intl.formatMessage(messages.manageModalMedia4k)}</Heading>
+              {media.status4k !== MediaStatus.AVAILABLE && (
+                <Button
+                  buttonType="success"
+                  className="w-full"
+                  onClick={() => markAvailable(true)}
+                  disabled={busy}
+                >
+                  {intl.formatMessage(
+                    mediaType === 'movie'
+                      ? messages.mark4kavailable
+                      : messages.markallseasons4kavailable
+                  )}
+                </Button>
+              )}
+              {removeButton(true)}
+            </>
+          )}
+
+          {media.status !== MediaStatus.BLOCKLISTED && (
+            <>
+              <Heading>{intl.formatMessage(messages.manageModalAdvanced)}</Heading>
+              <ConfirmButton
+                onClick={() => deleteMedia()}
+                confirmText={intl.formatMessage(globalMessages.areyousure)}
+                className="w-full"
+              >
+                <ThemedText className="text-white">
+                  {intl.formatMessage(messages.manageModalClearMedia)}
+                </ThemedText>
+              </ConfirmButton>
+              <ThemedText className="mb-2 mt-2 text-xs text-gray-400">
+                {intl.formatMessage(messages.manageModalClearMediaWarning, {
+                  mediaType: kind,
+                  mediaServerName,
+                })}
+              </ThemedText>
+            </>
+          )}
+        </>
+      )}
+    </Modal>
+  );
+};
+
+export default ManageSlideOver;
